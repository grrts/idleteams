# Defaults for every environment. Put secrets and machine-specific values in .env.local (not committed).
APP_ENV=dev
APP_SECRET=change-me-in-env-local

# SQLite needs no setup and is fine for local play. In production use MySQL/MariaDB or PostgreSQL, e.g.
# DATABASE_URL="mysql://idleteams:secret@127.0.0.1:3306/idleteams?serverVersion=8.0&charset=utf8mb4"
# DATABASE_URL="postgresql://idleteams:secret@127.0.0.1:5432/idleteams?serverVersion=16&charset=utf8"
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"

# Game clock. The design calls for 2-4 hour battles and a 12 hour offline cap; these short values make
# the proof of concept playable in one sitting. Production: GAME_BATTLE_SECONDS=10800, GAME_CHEST_SECONDS=3600,
# GAME_OFFLINE_CAP_SECONDS=43200.
GAME_BATTLE_SECONDS=150
GAME_CHEST_SECONDS=90
GAME_OFFLINE_CAP_SECONDS=600

# Mail for account verification and password reset. In production use a real transport, for example
# MAILER_DSN=smtp://user:pass@smtp.example.com:587 ; null://null drops every mail (local development).
MAILER_DSN=null://null
MAILER_FROM="Idle Teams <noreply@localhost>"
# The address players open the game at; used in links inside emails.
APP_URL=http://127.0.0.1:8000

###> symfony/mercure-bundle ###
# Live updates through a Mercure hub (https://mercure.rocks). Leave MERCURE_URL empty to poll instead.
# MERCURE_URL is where the app publishes (can be local), MERCURE_PUBLIC_URL where browsers listen; the hub must be
# on the same domain as the game (for example https://your-domain/.well-known/mercure) so the auth cookie reaches it.
MERCURE_URL=
MERCURE_PUBLIC_URL=
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"
MERCURE_JWT_ISSUER=idleteams
###< symfony/mercure-bundle ###
# Server errors are posted to this chat webhook (Slack, Discord, ...); empty: only logged.
ERROR_WEBHOOK_URL=

###> legal ###
# Who runs the game, shown in the terms and the privacy policy (/terms, /privacy). Set these before launch.
LEGAL_OPERATOR=
LEGAL_ADDRESS=
LEGAL_CONTACT=
###< legal ###

###> apps ###
# Origins of the native apps, which call the API across origins with a bearer token (src/EventListener/CorsListener.php):
# iOS (capacitor://localhost), Android (https://localhost) and the Steam build (app://idleteams).
CORS_ORIGINS=capacitor://localhost,https://localhost,app://idleteams
# Push to the phone apps through Firebase Cloud Messaging: the service account's JSON key (Firebase console > Project
# settings > Service accounts > Generate new private key), as the JSON text or a path to the file.
FCM_SERVICE_ACCOUNT=
###< apps ###

###> shop ###
# The cosmetic shop. The phone apps buy through RevenueCat (App Store and Google Play), the Steam build through Steam.
# The web build shows the offers and points to the apps. A store with no keys is simply not offered.
#
# RevenueCat: the public SDK keys for the apps, the secret API key (v1) for the server, and the Authorization header
# value you set on the webhook (Integrations > Webhooks, URL https://<host>/api/shop/revenuecat).
RC_PUBLIC_IOS_KEY=
RC_PUBLIC_ANDROID_KEY=
RC_SECRET_KEY=
RC_WEBHOOK_AUTH=
# Count test-mode (sandbox) purchases. Never on in production.
RC_ALLOW_SANDBOX=0
# Steam: the publisher Web API key (Users & Permissions > Manage Groups) and the app id. STEAM_SANDBOX=1 uses
# ISteamMicroTxnSandbox, where nothing is charged.
STEAM_WEB_API_KEY=
STEAM_APP_ID=
STEAM_SANDBOX=0
###< shop ###
